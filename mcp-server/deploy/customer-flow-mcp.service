[Unit]
Description=Customer Flow agency MCP gateway
After=network-online.target customer-flow-api.service
Wants=network-online.target customer-flow-api.service

[Service]
Type=simple
User=customer-flow
Group=customer-flow
WorkingDirectory=/opt/customer-flow/mcp-server
EnvironmentFile=/etc/customer-flow/mcp.env
ExecStart=/opt/customer-flow/mcp-server/.venv/bin/customer-flow-mcp
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/customer-flow
ReadWritePaths=/var/lib/customer-flow

[Install]
WantedBy=multi-user.target
