[Unit]
Description=Customer Flow agency MCP gateway
After=network-online.target customer-flow-api.service
Wants=network-online.target customer-flow-api.service

[Service]
Type=simple
WorkingDirectory=/home/dr/customer-flow/mcp-server
EnvironmentFile=/home/dr/.config/customer-flow/mcp.env
ExecStart=/home/dr/customer-flow/mcp-server/.venv/bin/customer-flow-mcp
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dr/customer-flow/api/data /home/dr/customer-flow/api/media

[Install]
WantedBy=default.target
