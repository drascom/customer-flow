# Same database/media paths used by customer-flow-api.service.
CF_DB_PATH=/var/lib/customer-flow/customer-flow.sqlite3
CF_MEDIA_ROOT=/var/lib/customer-flow/media
CF_API_MODULE_PATH=/opt/customer-flow/api

# Tool reads/writes go through the API so normal validation, audit and realtime
# ChangeBroker notifications are preserved. Plain HTTP is allowed only on loopback.
CF_API_BASE_URL=http://127.0.0.1:8080/api/v1
CF_MCP_API_TIMEOUT_SECONDS=15

# Public URL shown to admins and used as the MCP resource URL.
CF_PUBLIC_BASE_URL=https://customer-flow.example.com

# Bind only to loopback; the public reverse proxy maps /mcp to this service.
CF_MCP_HOST=127.0.0.1
CF_MCP_PORT=8091
CF_MCP_PATH=/mcp

# Safe default: only who_am_i, list_cases and get_case are registered.
CF_MCP_ENABLE_WRITES=false
CF_MCP_ENABLE_PHOTO_UPLOADS=false
CF_MCP_MAX_PHOTO_BYTES=8388608

# Local HTTP is accepted only for loopback development.
# CF_MCP_ALLOW_INSECURE_HTTP=true
