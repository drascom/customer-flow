# Customer Flow API. HTTPS is mandatory outside local development.
CF_MCP_API_BASE_URL=https://flow.drascom.uk

# Preferred for a long-running service: a dedicated active agent account assigned
# to one agency. Never use an admin, manager or doctor account here.
CF_MCP_API_USERNAME=agency.integration
CF_MCP_API_PASSWORD=replace-with-a-secret-from-the-service-environment

# Alternatively provide a temporary Customer Flow session token and leave the
# username/password values empty. Session tokens currently expire after 7 days.
# CF_MCP_API_TOKEN=replace-with-a-session-token

# Safe default: only who_am_i, list_cases and get_case are registered.
CF_MCP_ENABLE_WRITES=false
CF_MCP_ENABLE_PHOTO_UPLOADS=false
CF_MCP_MAX_PHOTO_BYTES=8388608

# stdio is best when the agency's MCP host launches this connector locally.
CF_MCP_TRANSPORT=stdio

# For hosted Streamable HTTP, bind to loopback and put an authenticated reverse
# proxy (OAuth/mTLS/access gateway) in front of this service.
# CF_MCP_TRANSPORT=streamable-http
# CF_MCP_HOST=127.0.0.1
# CF_MCP_PORT=8091
# CF_MCP_PATH=/mcp

CF_MCP_REQUEST_TIMEOUT_SECONDS=20
