[Unit]
Description=Customer Flow API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=customer-flow
Group=customer-flow
WorkingDirectory=/var/lib/customer-flow
EnvironmentFile=/etc/customer-flow/customer-flow.env
ExecStart=/usr/bin/python3 /opt/customer-flow/api/app.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/customer-flow

[Install]
WantedBy=multi-user.target
