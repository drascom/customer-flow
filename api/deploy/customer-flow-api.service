[Unit]
Description=Customer Flow API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=customer-flow
Group=customer-flow
WorkingDirectory=/opt/customer-flow/api
EnvironmentFile=-/etc/customer-flow/api.env
ExecStart=/usr/bin/python3 /opt/customer-flow/api/app.py --host 0.0.0.0 --port 8080 --db /var/lib/customer-flow/customer-flow.sqlite3 --media /var/lib/customer-flow/media
Environment=CF_ADMIN_DIR=/opt/customer-flow/admin-panel
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/customer-flow
ReadWritePaths=/var/lib/customer-flow

[Install]
WantedBy=multi-user.target
