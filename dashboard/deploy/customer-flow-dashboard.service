[Unit]
Description=Customer Flow private admin dashboard
After=network-online.target customer-flow-api.service
Wants=network-online.target

[Service]
Type=simple
User=customer-flow
Group=customer-flow
WorkingDirectory=/opt/customer-flow
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/customer-flow/dashboard.env
ExecStart=/usr/bin/python3 /opt/customer-flow/dashboard/app.py --host 0.0.0.0 --port 8081 --api-url http://127.0.0.1:8080 --admin-dir /opt/customer-flow/admin-panel
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/customer-flow

[Install]
WantedBy=multi-user.target
